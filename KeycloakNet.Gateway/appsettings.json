{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "web-bff-route": {
        "ClusterId": "web-bff-cluster",
        "Match": {
          "Path": "/bff/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "web-bff-cluster": {
        "Destinations": {
          "webBff": {
            "Address": "http://web-bff"
          }
        }
      }
    }
  }
}
