@inject NavigationManager Navigation
@inject IConfiguration Configuration

<div class="top-row ps-3 navbar navbar-dark bg-dark shadow-sm">
    <div class="container-fluid">
        <a class="navbar-brand fw-bold d-flex align-items-center gap-2" href="">
            <span class="fs-5">🔐</span>
            <span>KeycloakNet</span>
        </a>
    </div>
</div>

<input type="checkbox" title="Toggle navigation" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column py-2">
        <div class="nav-item px-3 mb-1">
            <NavLink class="nav-link py-2 d-flex align-items-center gap-2" href="" Match="NavLinkMatch.All">
                <span class="fs-6">🏠</span>
                <span>Dashboard</span>
            </NavLink>
        </div>
        <div class="nav-item px-3 mb-1">
            <NavLink class="nav-link py-2 d-flex align-items-center gap-2" href="bff-console">
                <span class="fs-6">🧪</span>
                <span>BFF Test Console</span>
            </NavLink>
        </div>
        <div class="nav-item px-3 mb-1">
            <NavLink class="nav-link py-2 d-flex align-items-center gap-2" href="admin/users">
                <span class="fs-6">👥</span>
                <span>User Management</span>
            </NavLink>
        </div>
    </nav>

    <!-- Sidebar Bottom: Session Status Panel -->
    <div class="sidebar-user-panel p-3 border-top border-light border-opacity-10 mt-auto" @onclick:stopPropagation="true">
        <AuthorizeView>
            <Authorized>
                <div class="d-flex align-items-center gap-2 mb-2">
                    <div class="avatar-circle bg-primary text-white fw-bold d-flex align-items-center justify-content-center rounded-circle" style="width: 34px; height: 34px; font-size: 0.9rem;">
                        @(GetInitial(context.User.Identity?.Name))
                    </div>
                    <div class="text-truncate text-white small" style="max-width: 150px;">
                        <div class="fw-bold text-truncate" title="@context.User.Identity?.Name">
                            @context.User.Identity?.Name
                        </div>
                        <div class="text-success small d-flex align-items-center gap-1" style="font-size: 0.72rem;">
                            <span>●</span> Authenticated
                        </div>
                    </div>
                </div>

                @{
                    var roles = context.User.Claims
                        .Where(c => c.Type is "role" or "http://schemas.microsoft.com/ws/2008/06/identity/claims/role" or "roles")
                        .Select(c => c.Value)
                        .Distinct()
                        .ToList();
                }

                @if (roles.Any())
                {
                    <div class="mb-2 d-flex flex-wrap gap-1">
                        @foreach (var role in roles)
                        {
                            <span class="badge bg-light bg-opacity-25 text-white" style="font-size: 0.68rem;">
                                @role
                            </span>
                        }
                    </div>
                }

                <div class="pt-1">
                    <a href="@GetLogoutUrl()" class="btn btn-outline-light btn-sm w-100 py-1" style="font-size: 0.78rem;">
                        Log Out
                    </a>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="text-white-50 small mb-2 d-flex align-items-center gap-2">
                    <span class="text-warning">●</span>
                    <span>Anonymous Visitor</span>
                </div>
                <div class="d-grid gap-1">
                    <a href="@GetLoginUrl()" class="btn btn-outline-light btn-sm py-1" style="font-size: 0.78rem;">
                        Log In
                    </a>
                    <a href="@GetRegisterUrl()" class="btn btn-primary btn-sm py-1 shadow-sm" style="font-size: 0.78rem;">
                        Register
                    </a>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</div>

@code {
    private string GatewayBaseUrl => Configuration["Gateway:BaseUrl"]?.TrimEnd('/')
        ?? throw new InvalidOperationException("Required configuration 'Gateway:BaseUrl' is missing.");

    private string GetInitial(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "U";
        return name[..1].ToUpperInvariant();
    }

    private string GetLoginUrl()
    {
        var returnUrl = Uri.EscapeDataString(Navigation.Uri);
        return $"{GatewayBaseUrl}/bff/login?returnUrl={returnUrl}";
    }

    private string GetRegisterUrl()
    {
        var returnUrl = Uri.EscapeDataString(Navigation.Uri);
        return $"{GatewayBaseUrl}/bff/register?returnUrl={returnUrl}";
    }

    private string GetLogoutUrl()
    {
        var returnUrl = Uri.EscapeDataString(Navigation.Uri);
        return $"{GatewayBaseUrl}/bff/logout?returnUrl={returnUrl}";
    }
}
